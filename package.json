{
  "name": "skill-space",
  "version": "0.1.38",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "description": "Local SkillOps desktop workspace for universal AI agent skills.",
  "author": "Skill-Space",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "pack:win": "npm run build && electron-builder --win --dir --config.electronDist=node_modules/electron/dist",
    "dist:win": "npm run build && electron-builder --win nsis --config.electronDist=node_modules/electron/dist",
    "test:marketplace": "node scripts/marketplace-smoke-test.cjs",
    "test:feishu": "node scripts/feishu-routing-smoke-test.cjs",
    "test:safety": "node scripts/publish-safety-smoke-test.cjs",
    "test:run-status": "node scripts/run-status-smoke-test.cjs",
    "test:all": "npm run typecheck && npm run test:marketplace && npm run test:feishu && npm run test:safety && npm run test:run-status"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.64.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.1.1",
    "@xyflow/react": "^12.10.0",
    "electron-updater": "^6.8.3",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.561.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "build": {
    "appId": "space.skillspace.desktop",
    "productName": "Skill-Space",
    "copyright": "Copyright © 2026 Skill-Space",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://ailabing.cn/downloads/skill-space/"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/skill-space-liquid.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skill-Space"
    }
  }
}
